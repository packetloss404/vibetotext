<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PacketVoice macOS hardened-runtime entitlements.

  Referenced by tauri.conf.json -> bundle.macOS.entitlements. Applied by codesign
  during `tauri build` when bundle.macOS.signingIdentity is set (CI injects the
  identity + thumbprint via secrets; both are null placeholders in tauri.conf.json).

  NOTE: Accessibility (global hotkey capture via rdev + auto-paste via enigo) is NOT
  an entitlement. It is a TCC privacy grant the user must approve at runtime under
  System Settings -> Privacy & Security -> Accessibility, gated by AXIsProcessTrusted()
  (see hotkey/permissions.rs). There is no plist key that pre-authorizes it.
-->
<plist version="1.0">
<dict>
  <!-- Microphone capture (cpal recorder). Pairs with NSMicrophoneUsageDescription
       in the bundle Info.plist for the TCC prompt. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- WKWebView / wry JavaScriptCore JIT under hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- Required by JavaScriptCore's W^X JIT and by some wry codepaths. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Allow loading the bundled whisper.cpp dynamic libs / DYLD env under
       hardened runtime. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Permit loading libraries not signed by PacketVoice (system + bundled). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
